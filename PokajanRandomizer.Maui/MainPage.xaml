<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PokajanRandomizer.Maui.MainPage"
             Title="Pokajan Randomizer"
             HideSoftInputOnTapped="True"
             BackgroundColor="#1F7A34"
             SafeAreaEdges="None">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>
    </ContentPage.Resources>

    <AbsoluteLayout x:Name="PageHost" SafeAreaEdges="None">
    <Grid x:Name="RootGrid"
          AbsoluteLayout.LayoutBounds="0,0,1,1"
          AbsoluteLayout.LayoutFlags="All"
          SafeAreaEdges="None">
        <Grid.Background>
            <RadialGradientBrush Center="0.25,0.25" Radius="1.0">
                <GradientStop Color="#2AA246" Offset="0.0" />
                <GradientStop Color="#1F7A34" Offset="0.55" />
                <GradientStop Color="#145726" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid x:Name="TableGrid" Padding="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SeatHost3"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    BackgroundColor="Transparent" />

            <Border x:Name="SeatHost4"
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent" />

            <Grid x:Name="CenterHost"
                  Grid.Row="1"
                  Grid.Column="1">
                <Grid x:Name="BoardHost"
                      SizeChanged="BoardHost_OnSizeChanged">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10">
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <Grid x:Name="CardsGrid"
                                  VerticalOptions="Center"
                                  RowSpacing="4"
                                  ColumnSpacing="3" />

                            <Border x:Name="BonusFrame"
                                    VerticalOptions="Center"
                                    Padding="8,8"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#3DF3FFD6">
                                <VerticalStackLayout Spacing="4">
                                    <Border x:Name="BonusCardHost"
                                            HorizontalOptions="Center"
                                            BackgroundColor="Transparent" />
                                    <Label x:Name="BonusTitle"
                                           Text="BONUS"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <Button x:Name="NewGameButton"
                                Text="New Game"
                                HorizontalOptions="Center"
                                BackgroundColor="#E8FFF0"
                                TextColor="#145726"
                                Clicked="NewGameButton_OnClick" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <Border x:Name="SeatHost2"
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent" />

            <Border x:Name="SeatHost1"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"
                    BackgroundColor="Transparent" />
        </Grid>

        <HorizontalStackLayout HorizontalOptions="Start"
                               VerticalOptions="Start"
                               Margin="8,6,0,0"
                               Spacing="8">
            <Button x:Name="InfoButton"
                    Text="Info"
                    BackgroundColor="#CCFFFFFF"
                    TextColor="#0D4A21"
                    Clicked="InfoButton_OnClick" />
            <Border x:Name="InfoHintPopup"
                    IsVisible="False"
                    Padding="8,4"
                    Stroke="#66000000"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#DDFFFFFF"
                    VerticalOptions="Center">
                <Label x:Name="InfoHintLabel"
                       Text="In case you dont know how to shuffle"
                       TextColor="#0D4A21"
                       FontAttributes="Bold" />
            </Border>
        </HorizontalStackLayout>
    </Grid>

        <Grid x:Name="InfoOverlay"
              IsVisible="False"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="#B3000000"
              SafeAreaEdges="None">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="InfoOverlay_OnTapped" />
            </Grid.GestureRecognizers>
            <ScrollView HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="20">
                <Border Padding="20,16"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#E6123A24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="InfoOverlay_OnTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="How to shuffle"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold" />
                        <Label x:Name="InfoBodyText"
                               Margin="0,12,0,0"
                               TextColor="White"
                               FontSize="14" />
                        <Label Margin="0,14,0,0"
                               HorizontalOptions="Center"
                               TextColor="#CCFFFFFF"
                               FontSize="12"
                               Text="Tap anywhere to close" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <Grid x:Name="ClaimOverlay"
              IsVisible="False"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="#B3000000"
              SafeAreaEdges="None">
            <ScrollView HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Margin="12">
                <Border HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="16,12"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#E6123A24">
                    <Grid>
                        <VerticalStackLayout x:Name="ClaimPickPage">
                            <Label x:Name="ClaimPickTitle"
                                   Text="Pokajan"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <ScrollView Orientation="Horizontal" Margin="0,10,0,0">
                                <HorizontalStackLayout x:Name="ClaimSlotsHost"
                                                       HorizontalOptions="Center"
                                                       Spacing="10" />
                            </ScrollView>
                            <Label x:Name="ClaimErrorText"
                                   Margin="0,8,0,0"
                                   HorizontalOptions="Center"
                                   TextColor="#FFD9A0"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Margin="0,12,0,0"
                                                   Spacing="10">
                                <Button x:Name="ClaimCancelButton"
                                        Text="Cancel"
                                        BackgroundColor="#33FFFFFF"
                                        TextColor="White"
                                        Clicked="ClaimCancelButton_OnClick" />
                                <Button x:Name="ClaimConfirmButton"
                                        Text="Confirm"
                                        BackgroundColor="#E8FFF0"
                                        TextColor="#145726"
                                        Clicked="ClaimConfirmButton_OnClick" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ClaimSourcePage"
                                             IsVisible="False"
                                             HorizontalOptions="Center">
                            <Label Text="How did they Pokajan?"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="ClaimPayoutHint"
                                   Margin="0,8,0,0"
                                   HorizontalOptions="Center"
                                   TextColor="#CCFFFFFF"
                                   FontSize="14" />
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Margin="0,14,0,0"
                                                   Spacing="10">
                                <Button Text="Self pulled"
                                        BackgroundColor="#E8FFF0"
                                        TextColor="#145726"
                                        Clicked="ClaimSelfPulled_OnClick" />
                                <Button Text="Discarded"
                                        BackgroundColor="#33FFFFFF"
                                        TextColor="White"
                                        Clicked="ClaimDiscarded_OnClick" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ClaimPayerPage"
                                             IsVisible="False"
                                             HorizontalOptions="Center">
                            <Label Text="Who pays?"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <VerticalStackLayout x:Name="ClaimPayerHost"
                                                 Margin="0,12,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ClaimDeltaPage"
                                             IsVisible="False"
                                             HorizontalOptions="Center">
                            <Label Text="Coin change"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <VerticalStackLayout x:Name="ClaimDeltaHost"
                                                 Margin="0,12,0,0" />
                            <Button Text="Done"
                                    Margin="0,14,0,0"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#E8FFF0"
                                    TextColor="#145726"
                                    Clicked="ClaimDeltaDone_OnClick" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </ScrollView>
        </Grid>

        <Grid x:Name="CardPickerOverlay"
              IsVisible="False"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="#B3000000"
              SafeAreaEdges="None">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CardPickerOverlay_OnTapped" />
            </Grid.GestureRecognizers>
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="16"
                    Padding="14,10"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#E6123A24">
                <VerticalStackLayout>
                    <Label Text="Pick a card"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <ScrollView x:Name="CardPickerScroll"
                                Margin="0,8,0,0">
                        <FlexLayout x:Name="CardPickerHost"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Start" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </AbsoluteLayout>
</ContentPage>
